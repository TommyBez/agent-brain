    "@modelcontextprotocol/server": "^2.0.0",
    "@vercel/functions": "^3.9.7",
    "better-auth": "1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "gpt-tokenizer": "^4.0.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
