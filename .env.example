# Local/non-Vercel origin. HTTPS required except for local development.
# Vercel production uses https://VERCEL_PROJECT_PRODUCTION_URL; previews use
# https://VERCEL_URL. Both system variables are supplied by Vercel, not set here.
# BETTER_AUTH_URL is ignored in Vercel production and preview deployments.
BETTER_AUTH_URL=http://localhost:3000
# Application settings: random secret (32+ chars) and the emails allowed to
# sign in. Separate addresses with commas. Each address has its own brain.
# Public signup stays disabled; create each account with pnpm owner:bootstrap.
BETTER_AUTH_SECRET=
BRAIN_OWNER_EMAIL=
# Optional comma-separated browser client origins allowed for remote MCP/OAuth.
MCP_ALLOWED_ORIGINS=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
# Set only after reading back the daily native snapshot schedule.
NEON_SNAPSHOT_SCHEDULE_VERIFIED_AT=
CRON_SECRET=
EMBEDDING_MODEL=openai/text-embedding-3-small
# Dedicated key for interactive query embeddings, configured with a $1/month cap.
BRAIN_EMBEDDING_API_KEY=
# Optional: false forces text-and-graph retrieval without server inference.
BRAIN_QUERY_EMBEDDINGS=true
# The Jev/DeepSeek pipeline automatically applies changes that pass verification.
CONSOLIDATION_TASK_BUDGET=2000
# Vercel Workflow: dedicated consolidation + page indexing key.
# Consolidation has a persisted $1/day ceiling for each present account.
# Provider limits are separate. The accounts share one pool of that size.
AI_GATEWAY_API_KEY=
# One private repository per account: email=owner/repository, comma-separated.
# An account without an entry is not exported. The branch is shared. The token
# needs Contents read/write on every listed repository. No GitHub Actions runner.
BRAIN_EXPORT_REPOSITORIES=
BRAIN_EXPORT_BRANCH=main
# Sensitive Vercel value.
BRAIN_EXPORT_GITHUB_TOKEN=
