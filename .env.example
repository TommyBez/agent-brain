# Application settings: HTTPS production origin, random secret (32+ chars), owner email.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BRAIN_OWNER_EMAIL=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
# Set only after reading back the daily native snapshot schedule.
NEON_SNAPSHOT_SCHEDULE_VERIFIED_AT=
CRON_SECRET=
BRAIN_RUNNER_REPOSITORY=
EMBEDDING_MODEL=openai/text-embedding-3-small
CONSOLIDATION_MODEL=deepseek/deepseek-v4.1-flash

# Separate runner only: do not add these credentials to the Next.js deployment.
BRAIN_URL=
BRAIN_AGENT_TOKEN=
AI_GATEWAY_API_KEY=
BRAIN_EXPORT_DIRECTORY=export
BRAIN_EXPORT_COMMIT=false
